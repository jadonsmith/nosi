# ─────────────────────────────────────────────────────────────
# NOSI configuration. Copy to .env.local for local dev.
# ─────────────────────────────────────────────────────────────

# Postgres connection string.
#   Example: postgres://nosi:nosi@127.0.0.1:5432/nosi
# Leave BLANK to fall back to an embedded Postgres (PGlite) at ./.pglite —
# handy for a first look, but it is single-process only, so the dev server
# and the CLI scripts can't both use it at once. Prefer a real Postgres.
DATABASE_URL=

# Shared bearer token every agent must send: Authorization: Bearer <token>
# Generate one:  openssl rand -hex 24
INGEST_TOKEN=dev-ingest-token-change-me

# Password for the admin login (host deletion, labels, map pins)
ADMIN_PASSWORD=admin

# Secret used to sign the admin session cookie (32+ random chars)
# Generate one:  openssl rand -hex 32
SESSION_SECRET=dev-session-secret-change-me-please-0000000000000000

# Minutes since last heartbeat before a host is "stale", then "down"
NOSI_STALE_MINUTES=2
NOSI_DOWN_MINUTES=10

# Best-effort IP geolocation (ip-api.com) to place new hosts on the map
NOSI_GEOLOCATE=true
